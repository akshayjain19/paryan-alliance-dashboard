{
  "entities": {
    "PostMetrics": {
      "title": "Post Metrics",
      "description": "Funnel metrics for an Instagram post",
      "type": "object",
      "properties": {
        "comments": { "type": "number", "description": "Total Instagram comments" },
        "dmsSent": { "type": "number", "description": "Total DMs sent" },
        "whatsappVisits": { "type": "number", "description": "Total WhatsApp bot visits" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["comments", "dmsSent", "whatsappVisits"]
    }
  },
  "firestore": {
    "/posts": {
      "schema": "PostMetrics",
      "description": "Collection containing post funnel metrics"
    }
  }
}
